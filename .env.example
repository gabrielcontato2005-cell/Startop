# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: só no servidor (Vercel), nunca no celular nem no GitHub
SUPABASE_SECRET_KEY=sb_secret_...
# Supabase → Connect → Transaction pooler (porta 6543), com a senha do banco
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Só para desenvolvimento local sem login (ignorado em produção):
# AUTH_DEV_EMAIL=dono@startop.local
